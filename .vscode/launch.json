{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ST-Link GDB Server",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceFolder}/build/Release/${workspaceFolderBasename}.elf",
            "servertype": "stlink",
            "device": "STM32F030F4P6",
            "interface": "swd",
            "runToEntryPoint": "main",
            "serverArgs": [
                //limited output log
                "-l",
                "1",
                //access port ID
                "-m",
                "0",
                "-s", //flash check after load
                "-k", //connect under reset
                "-d" //frequency output
            ],
            "swoConfig": {
                "enabled": false
            },
            "svdFile": "${workspaceFolder}/STM32F0x0.svd"
        },
        {
            "name": "J-Link",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F030f4",
            "interface": "swd",
            "runToEntryPoint": "main",
            "executable": "${workspaceFolder}/build/Release/${workspaceFolderBasename}.elf",
            "serverArgs": [
                "-strict",
                "-timeout",
                "0"
            ],
            "swoConfig": {
                "enabled": false
            },
            "rttConfig": {
                "enabled": false,
                "address": "auto",
                "decoders": [
                    {
                        "port": 0,
                        "type": "console",
                        "label": "RTT Output",
                        "showOnStartup": true
                    }
                ]
            },
            "svdFile": "${workspaceFolder}/STM32F0x0.svd"
        },
        {
            "name": "OpenOCD",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "servertype": "openocd",
            "device": "STM32F030F4P6",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f0x.cfg"
            ],
            "runToEntryPoint": "main",
            "gdbTarget": "localhost:3333",
            "preLaunchCommands": [
                "monitor arm semihosting enable"
            ],
            "swoConfig": {
                "enabled": false
            }
        },
        {
            "name": "st-util",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "servertype": "stutil",
            "device": "STM32F030F4P6",
            "runToEntryPoint": "main",
            "swoConfig": {
                "enabled": false
            }
        }
    ]
}